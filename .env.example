# Backend
ENVIRONMENT=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
OPENAI_API_KEY=sk-your-openai-key
DEMO_OWNER_PASSWORD=replace-with-private-demo-password
FRONTEND_URL=http://localhost:3000
JWT_SECRET_KEY=replace-with-long-random-secret

# Optional backend settings
CORS_ORIGINS=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_RETRIEVAL_MODE=semantic
DECISION_CONTEXT_DEBUG=false

# Jannat/Dairtna pilot tenant entitlement (M4-M7). Fail-closed by design:
# leave unset in any environment where the pilot integrations (Operational
# Truth Context, Company Brain, upload-to-Truth bridge) should stay
# disabled. When set, must be the exact company UUID - never a name, slug,
# or alias. Do not commit a real value here or in any tracked file.
JANNAT_COMPANY_ID=

# M7 Slice 3A: controls participation of legacy/static operational pilot
# workbooks under data_sources/... (poultry static scan + feed-mill static
# scan). Default true - leave unset for normal behavior. Set to false only
# to make Golden E2E provenance deterministic (e.g. proving an upload's
# Truth is not mixed with static pilot data); never affects uploaded Truth,
# Company Brain (knowledge/dairtna), or Truth semantics.
NAWA_STATIC_PILOT_DATA_SOURCES_ENABLED=true

# Frontend
NEXT_PUBLIC_AIMX_API_URL=http://localhost:8000

# M7 Slice 3B: Playwright browser E2E infrastructure (frontend/e2e).
# Never a fallback to the normal developer DATABASE_URL above - the
# database name must clearly identify itself as E2E-only, or
# scripts/e2e_db_guard.py refuses to run migrations or start the backend.
# See scripts/e2e_orchestrator.py for the full safety contract.
E2E_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME_e2e
E2E_BACKEND_PORT=8100
E2E_FRONTEND_PORT=3100
